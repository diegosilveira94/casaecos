# ---- Banco (Postgres via docker-compose) ----
POSTGRES_USER=casaecos
POSTGRES_PASSWORD=casaecos
POSTGRES_DB=casaecos
POSTGRES_PORT=5432

# URL usada pelo Prisma (apps/api)
DATABASE_URL="postgresql://casaecos:casaecos@localhost:5432/casaecos?schema=public"

# ---- API ----
NODE_ENV=development
API_PORT=3333
CORS_ORIGIN=http://localhost:5173

# ---- Autenticação (ECOS-13) ----
# Gere o seu: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-este-valor-por-um-segredo-de-no-minimo-32-caracteres
# Validade do token em segundos (28800 = 8h, um turno de trabalho)
JWT_EXPIRES_IN_SECONDS=28800
# Rate limit da rota de login (tentativas por IP na janela)
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

# ---- Primeiro coordenador (npm run db:seed:admin) ----
# Só é usado pelo script de bootstrap; sem isso não existe ninguém para criar as
# demais credenciais, porque POST /auth/accounts exige token de Coordenador.
ADMIN_NAME=Coordenacao
ADMIN_EMAIL=coordenacao@ecosdaesperanca.org.br
ADMIN_PASSWORD=troque-esta-senha

# ---- Web (Vite: só variáveis com prefixo VITE_ chegam no browser) ----
VITE_API_URL=http://localhost:3333
